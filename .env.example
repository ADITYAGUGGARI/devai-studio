# API: loaded by make dev-api, make worker, make scheduler and Compose.
DATABASE_URL=sqlite:///./devai.db
ADMIN_API_KEY=local-dev-only
CORS_ORIGINS=http://localhost:5173

# Provider secrets belong only in this server environment.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VERIFY_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1088x1360
OPENAI_IMAGE_QUALITY=medium
IMAGE_VALIDATION_ATTEMPTS=2

# API processes persisted jobs by default. Disable when running separate workers.
BACKGROUND_WORKER_ENABLED=true
# Enable to enqueue one daily pipeline in the API/worker. make scheduler also enqueues daily jobs.
DAILY_ENABLED=false
DAILY_TIMEZONE=America/Chicago
DAILY_HOUR=8
CAROUSEL_ARTWORK_DIR=.local-data/carousel-artwork
PUBLISH_MEDIA_DIR=.local-data/publishing-media

# Instagram professional account, Facebook Login flow and approved app permissions.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
META_GRAPH_VERSION=v24.0
# HTTPS public API origin (or origin + proxy prefix); Meta fetches /media/<token>.jpg here.
PUBLIC_MEDIA_BASE_URL=

POSTGRES_PORT=5433
