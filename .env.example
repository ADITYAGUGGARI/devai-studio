# API: loaded by `make dev-api`; Compose uses these values below.
DATABASE_URL=sqlite:///./devai.db
ADMIN_API_KEY=local-dev-only
CORS_ORIGINS=http://localhost:5173

# Required only for AI-generated drafts. Without it, research runs cannot create a carousel.
# Keep provider keys server-side; never copy this value into web/.env or mobile/.env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-2

# Optional: live publishing is a separate integration, not enabled by setup.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
META_GRAPH_VERSION=v24.0

# Single-instance discovery worker, started explicitly.
DAILY_TIMEZONE=America/Chicago
DAILY_HOUR=8

# Optional font file overrides; OS fonts and Pillow fallback work without these.
CAROUSEL_FONT_REGULAR=
CAROUSEL_FONT_BOLD=
CAROUSEL_ARTWORK_DIR=.local-data/carousel-artwork

# Docker-only PostgreSQL host port, separate from other local projects.
POSTGRES_PORT=5433
