{
  "name": "devai-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "npm --prefix web run dev",
    "dev:mobile": "npm --prefix mobile start",
    "build": "npm --prefix web run build",
    "typecheck": "npm --prefix web run typecheck && npm --prefix mobile run typecheck",
    "lint": "eslint web mobile --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run build",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.46.0"
  }
}
