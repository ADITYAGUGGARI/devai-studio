"></button></figure><figure data-screen="REVIEW-02" data-platform="desktop" data-role="style" data-text="review-02 · review content · desktop · polished reference"><figcaption><span class="eyebrow">REVIEW-02-desktop-polished</span><h2>Review content</h2><p>Style reference only · follow written behavior · DESKTOP · polished reference</p></figcaption><button class="image-button" aria-label="Open full-size REVIEW-02 · Review content · DESKTOP · polished reference"><img loading="lazy" alt="REVIEW-02 · Review content · DESKTOP · polished reference" src="data:image/jpeg;base64,"></button></figure><figure data-screen="REVIEW-02" data-platform="ios" data-role="style" data-text="review-02 · review content · ios · polished reference"><figcaption><span class="eyebrow">REVIEW-02-ios-polished</span><h2>Review content</h2><p>Style reference only · follow written behavior · IOS · polished reference</p></figcaption><button class="image-button" aria-label="Open full-size REVIEW-02 · Review content · IOS · polished reference"><img loading="lazy" alt="REVIEW-02 · Review content · IOS · polished reference" src="data:image/jpeg;base64,"></button></figure></main><dialog aria-label="Full-size design"><button id="close" autofocus>Close preview</button><img alt=""></dialog><footer>Revision 4 · Written interaction contracts and current design tokens define implementation. This is a design handoff, not a working application or production certification. Editable sources, API mappings, acceptance criteria and release gates are included in the ZIP.</footer><script>const ps=document.querySelector('#platform'),ss=document.querySelector('#screen'),rs=document.querySelector('#role'),qs=document.querySelector('#query'),fs=[...document.querySelectorAll('figure')];function filter(){let n=0;for(const f of fs){let matchScreen=ss.value==='all'||f.dataset.screen===ss.value||(ss.value==='dialogs'&&f.dataset.screen.startsWith('D-'));let show=matchScreen&&(ps.value==='all'||f.dataset.platform===ps.value)&&(rs.value==='all'||f.dataset.role===rs.value)&&f.dataset.text.includes(qs.value.toLowerCase());f.hidden=!show;if(show)n++}document.querySelector('#count').textContent=n+' designs shown';}for(const el of [ps,ss,rs])el.addEventListener('change',filter);qs.addEventListener('input',filter);const d=document.querySelector('dialog'),di=d.querySelector('img');document.querySelector('#close').addEventListener('click',()=>d.close());for(const b of document.querySelectorAll('.image-button'))b.addEventListener('click',()=>{const img=b.querySelector('img');di.src=img.src;di.alt=img.alt;d.showModal()});filter();</script></body></html>